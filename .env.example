# =================================================================
# VoiceRAG Environment Configuration
# =================================================================

# --- Speech-to-Text (Sarvam STT) ---
# Optional: Provide your Sarvam AI API subscription key for live Indic speech recognition.
# If omitted, VoiceRAG uses browser Web Speech API & local test harness.
SARVAM_API_KEY=

# --- Fast LLM Synthesis (Groq / OpenAI) ---
# Optional: Provide Groq API key for ultra-fast Llama-3.1-8b-instant generation (~60ms)
# or OpenAI API key. If omitted, VoiceRAG uses sub-10ms local grounded synthesis.
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
