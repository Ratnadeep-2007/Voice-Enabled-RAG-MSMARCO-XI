# =================================================================
# VoiceRAG Environment Configuration
# =================================================================

# --- Speech-to-Text (Sarvam STT) ---
# Optional: Provide your Sarvam AI API subscription key for live Indic speech recognition.
# If omitted, VoiceRAG uses browser Web Speech API & local test harness.
SARVAM_API_KEY=

# --- Fast LLM Synthesis (Cerebras / Groq / OpenAI) ---
# Primary: Cerebras Wafer-Scale Engine (1,800+ tok/s, ~20ms generation)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Alternative: OpenRouter (Qwen3 / Qwen2.5) / Groq / OpenAI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
