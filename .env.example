# =================================================================
# VoiceRAG Environment Configuration
# =================================================================

# --- Active LLM Reasoning Provider ---
# Options: commandcode, cerebras, groq, openrouter, openai, local
LLM_PROVIDER=commandcode

# --- CommandCode AI Provider (DeepSeek V4 Flash / DeepSeek R1) ---
# Endpoint: https://api.commandcode.ai/provider/v1/chat/completions
CMD_API_KEY=your_commandcode_api_key_here
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash

# --- Cerebras Wafer-Scale Engine (WSE-3) Provider ---
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=llama-3.3-70b

# --- Groq LPU Provider (Meta Llama-3.3-70B Versatile / 3.1-8B) ---
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# --- Speech-to-Text (Sarvam STT) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=saaras:v3

# --- OpenRouter Provider (Qwen 2.5 / Multilingual fallback) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# --- OpenAI Provider (Optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
DEBUG=false
